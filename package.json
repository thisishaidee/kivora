{
  "name": "kivora",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "build": "npm run typecheck && vite build",
    "build:worker": "mkdir -p dist-worker && esbuild worker/src/index.ts --bundle --minify --legal-comments=none --format=esm --platform=browser --target=es2022 --outfile=dist-worker/worker.js"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.8.3",
    "vite": "6.4.6",
    "vitest": "5.1.0",
    "esbuild": "0.25.12"
  }
}
